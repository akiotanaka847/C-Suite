#!/usr/bin/env bash
# Template for scripts/fly-secrets.sh — the real file is gitignored.
#
# This file is the structural source of truth: when a new env var is
# added to ``packages/core/openexecutive/config.py`` or read by the
# Next.js UI, mirror it here so collaborators know it exists.
#
# Real values come from the repo-root ``.env`` (also gitignored, also the
# file ``packages/core`` reads at startup). The ``${VAR:?msg}`` expansions
# below abort before ``fly secrets set`` runs if a required value is
# missing — half-applied pushes are impossible.

set -euo pipefail

_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
_env_file="${OPENEXEC_ENV:-${_repo_root}/.env}"
if [[ -f "$_env_file" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$_env_file"
  set +a
else
  echo "warning: $_env_file not found — relying on already-exported env vars" >&2
fi

API_APP="${OPENEXEC_API_APP:-openexec-api-dev}"
UI_APP="${OPENEXEC_UI_APP:-openexec-ui-dev}"

anthropic_key() {
  fly secrets set --app "$API_APP" \
    ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:?ANTHROPIC_API_KEY missing from $_env_file}"
}

openrouter() {
  fly secrets set --app "$API_APP" \
    OPENROUTER_ENABLED="${OPENROUTER_ENABLED:-true}" \
    OPENROUTER_API_KEY="${OPENROUTER_API_KEY:?OPENROUTER_API_KEY missing from $_env_file}" \
    OPENROUTER_APP_TITLE="${OPENROUTER_APP_TITLE:-Open Executive (dev)}" \
    OPENROUTER_REFERER="${OPENROUTER_REFERER:-https://openexec-ui-dev.fly.dev}"
}

backend_shared_secret() {
  local secret="${BACKEND_SHARED_SECRET:?BACKEND_SHARED_SECRET missing from $_env_file}"
  fly secrets set --app "$API_APP" BACKEND_SHARED_SECRET="$secret"
  fly secrets set --app "$UI_APP"  BACKEND_SHARED_SECRET="$secret"
}

slack() {
  fly secrets set --app "$API_APP" \
    SLACK_BOT_TOKEN="${SLACK_BOT_TOKEN:?SLACK_BOT_TOKEN missing from $_env_file}" \
    SLACK_APP_TOKEN="${SLACK_APP_TOKEN:?SLACK_APP_TOKEN missing from $_env_file}"
}

email() {
  # Inbound sender access is roster-driven (the People table) — no env
  # allowlist. Manage allowed senders via the /people UI.
  fly secrets set --app "$API_APP" \
    EXEC_EMAIL_ADDRESS="${EXEC_EMAIL_ADDRESS:?EXEC_EMAIL_ADDRESS missing from $_env_file}"
}

telegram() {
  # Inbound chat_id access is roster-driven; no TELEGRAM_ALLOWED_CHAT_IDS.
  fly secrets set --app "$API_APP" \
    TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN:?TELEGRAM_BOT_TOKEN missing from $_env_file}" \
    TELEGRAM_WEBHOOK_SECRET="${TELEGRAM_WEBHOOK_SECRET:?TELEGRAM_WEBHOOK_SECRET missing from $_env_file}"
}

discord() {
  fly secrets set --app "$API_APP" \
    DISCORD_BOT_TOKEN="${DISCORD_BOT_TOKEN:?DISCORD_BOT_TOKEN missing from $_env_file}" \
    DISCORD_PUBLIC_KEY="${DISCORD_PUBLIC_KEY:?DISCORD_PUBLIC_KEY missing from $_env_file}" \
    DISCORD_APPLICATION_ID="${DISCORD_APPLICATION_ID:?DISCORD_APPLICATION_ID missing from $_env_file}"
}

auth() {
  fly secrets set --app "$UI_APP" \
    AUTH_SECRET="${AUTH_SECRET:?AUTH_SECRET missing from $_env_file}" \
    AUTH_GOOGLE_ID="${AUTH_GOOGLE_ID:?AUTH_GOOGLE_ID missing from $_env_file}" \
    AUTH_GOOGLE_SECRET="${AUTH_GOOGLE_SECRET:?AUTH_GOOGLE_SECRET missing from $_env_file}" \
    ALLOWED_EMAILS="${ALLOWED_EMAILS:?ALLOWED_EMAILS missing from $_env_file}" \
    AUTH_TRUST_HOST="${AUTH_TRUST_HOST:-true}" \
    AUTH_URL="${AUTH_URL:-https://openexec-ui-dev.fly.dev}"
}

sync_all() {
  local pushed=()
  [[ -n "${ANTHROPIC_API_KEY:-}" ]]   && anthropic_key   && pushed+=("anthropic_key")
  [[ -n "${OPENROUTER_API_KEY:-}" ]]  && openrouter      && pushed+=("openrouter")
  [[ -n "${BACKEND_SHARED_SECRET:-}" ]] && backend_shared_secret && pushed+=("backend_shared_secret")
  [[ -n "${SLACK_BOT_TOKEN:-}" && -n "${SLACK_APP_TOKEN:-}" ]] && slack && pushed+=("slack")
  [[ -n "${EXEC_EMAIL_ADDRESS:-}" ]] && email && pushed+=("email")
  [[ -n "${TELEGRAM_BOT_TOKEN:-}" ]]  && telegram        && pushed+=("telegram")
  [[ -n "${DISCORD_BOT_TOKEN:-}" ]]   && discord         && pushed+=("discord")
  [[ -n "${AUTH_SECRET:-}" ]]         && auth            && pushed+=("auth")
  echo "pushed: ${pushed[*]:-none}"
}

# Names + digests + timestamps. Fly NEVER returns secret values — this is
# the read-side equivalent of ``fly secrets set``.
list_all() {
  echo "=== $API_APP ==="
  fly secrets list --app "$API_APP"
  echo
  echo "=== $UI_APP ==="
  fly secrets list --app "$UI_APP"
}

# Non-secret env from fly.{api,ui}.toml ``[env]`` blocks.
config_env_all() {
  echo "=== $API_APP (fly.api.toml [env]) ==="
  fly config env --app "$API_APP"
  echo
  echo "=== $UI_APP (fly.ui.toml [env]) ==="
  fly config env --app "$UI_APP"
}

# The only way to actually see secret VALUES — dump ``env`` inside a
# running machine. Fly injects all secrets as env vars at boot.
dump_env_api() { _dump_env_for "$API_APP"; }
dump_env_ui()  { _dump_env_for "$UI_APP"; }

_dump_env_for() {
  local app="$1"
  local machine
  machine=$(fly machine list --app "$app" --json | jq -r '.[0].id')
  if [[ -z "$machine" || "$machine" == "null" ]]; then
    echo "no running machine for $app" >&2
    return 1
  fi
  echo "=== $app (machine $machine) ==="
  fly ssh console --app "$app" --machine "$machine" -C 'env' \
    | sort \
    | grep -v -E '^(PATH|HOME|TERM|HOSTNAME|PWD|SHLVL|FLY_)='
}

tail_api() { fly logs --app "$API_APP"; }
tail_ui()  { fly logs --app "$UI_APP"; }

check_models() {
  curl -sS \
    -H "x-api-key: ${BACKEND_SHARED_SECRET:?BACKEND_SHARED_SECRET missing from $_env_file}" \
    "https://openexec-api-dev.fly.dev/agents/models" | jq
}
